{
  "is-main": true,
  "import": [
    "peter-jerry-ye/wasi",
    "Yoorkin/ArgParser",
    "moonbitlang/yacc/lib/driver",
    "moonbitlang/yacc/lib/codegen",
    "moonbitlang/yacc/lib/codegen/gen_mbt",
    "moonbitlang/yacc/lib/driver/util",
    "moonbitlang/yacc/lib/codegen/gen_mbt_table"
  ],
  "link": {
    "native": {
      "cc": "clang",
      "cc-flags": "-O2 .mooncakes/moonbitlang/x/fs/internal/ffi/native_stub.c"
    },
    "js": {
      "format": "cjs"
    },
    "wasm": {
      "export-memory-name": "memory"
    }
  },
  "bin-name": "moonyacc",
  "bin-target": "js"
}
