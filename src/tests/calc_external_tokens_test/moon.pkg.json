{
  "pre-build": [
    {
      "command": "wasmer run . --dir=$mod_dir -- $input --mode only-tokens -o $output",
      "input": "calc.mbty",
      "output": "calc_tokens.mbt"
    },
    {
      "command": "wasmer run . --dir=$mod_dir -- $input --external-tokens -o $output",
      "input": "calc.mbty",
      "output": "calc.mbt"
    }
  ]
}
