{
  "pre-build": [
    {
      "command": "iwasm --module-path=$mod_dir/boot --dir=$mod_dir $mod_dir/boot/moonyacc.wasm $input --mode only-tokens -o $output",
      "input": "calc.mbty",
      "output": "calc_tokens.mbt"
    },
    {
      "command": "iwasm --module-path=$mod_dir/boot --dir=$mod_dir $mod_dir/boot/moonyacc.wasm $input --external-tokens -o $output",
      "input": "calc.mbty",
      "output": "calc.mbt"
    }
  ]
}
